        <mxCell id="eIposEHRdqCibFXUl9mP-5" value="UI Designer" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=light-dark(#000000,#9AC7BF);fontSize=13;" vertex="1" parent="1">
